# Live feeds: generated at deploy time by pipeline/live/fetch_live.py, not committed
site/data/live/
raw/live_cache/
raw/infra/

# Raw downloads (see raw/README.md); only the README is committed
raw/*
!raw/README.md

# Local output
__pycache__/
tools/shots/
dist/
# offline store (tools/offline.py) belongs outside the repo; this guards against a symlink or --dir inside it
site/offline/
atlas-offline/
